GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Comma-separated approved Google email addresses. Empty denies all sign-ins.
GOOGLE_OAUTH_ALLOWED_EMAILS=
REDIS_URL=redis://localhost:6379
SERVICE_SHEET_ID=
# Service account with edit access to SERVICE_SHEET_ID.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Quoted PEM private key; escaped \n sequences are supported.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
