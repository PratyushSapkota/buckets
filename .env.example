GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated Google email addresses. An empty list denies all sign-ins.
GOOGLE_OAUTH_ALLOWED_EMAILS=you@example.com,teammate@example.com

NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# Register http://localhost:3000/api/auth/callback/google in Google Cloud.
# NextAuth derives the callback URL from NEXTAUTH_URL; GOOGLE_OAUTH_CALLBACK_URL is no longer used.
