GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated Google email addresses. An empty list denies all sign-ins.
GOOGLE_OAUTH_ALLOWED_EMAILS=you@example.com,teammate@example.com

# Required locally and outside Vercel. On Vercel, omit to use its system VERCEL_URL.
# Once known, explicitly set your stable HTTPS production origin for Google callbacks.
NEXTAUTH_URL=http://localhost:3000
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# ID from https://docs.google.com/spreadsheets/d/<ID>/edit (not the full URL).
SERVICE_SHEET_ID=
# Share that private spreadsheet with this service account as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# PEM private key: quoted with literal \n escapes, or a quoted multiline value.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Register http://localhost:3000/api/auth/callback/google in Google Cloud.
# NextAuth uses NEXTAUTH_URL, or Vercel's deployment URL when omitted on Vercel.
# GOOGLE_OAUTH_CALLBACK_URL is no longer used.
